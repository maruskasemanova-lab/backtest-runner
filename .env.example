# -------- Backtest Runner (backend) --------

# CORS (include your Cloudflare Pages domain + localhost for local dev)
BACKTEST_CORS_ALLOW_ORIGINS=https://your-app.pages.dev,http://localhost:5173,http://127.0.0.1:5173
# Optional regex for Pages preview URLs
BACKTEST_CORS_ALLOW_ORIGIN_REGEX=^https://(?:[a-z0-9-]+\.)?your-app\.pages\.dev$

# Internal strategy API (deployed as second persistent backend service)
# Example Fly URL: https://your-strategy-api.fly.dev
BACKTEST_INTERNAL_STRATEGY_API_URL=https://your-strategy-api.fly.dev
BACKTEST_STRATEGY_API_ALLOWLIST=https://your-strategy-api.fly.dev,http://localhost:8001,http://127.0.0.1:8001
# Token for protected strategy API endpoints (`x-internal-token` header).
# Must match strategy service `STRATEGY_INTERNAL_API_TOKEN`.
BACKTEST_STRATEGY_INTERNAL_API_TOKEN=
# Local-only fallback when hitting localhost/127.0.0.1/strategy-api and token is unset.
BACKTEST_STRATEGY_LOCAL_DEV_TOKEN_FALLBACK=1
BACKTEST_STRATEGY_LOCAL_DEV_INTERNAL_API_TOKEN=dev-internal-token

# SaaS/auth
BACKTEST_JWT_SECRET=replace_me
SUPABASE_JWT_SECRET=replace_me
BACKTEST_ALLOW_UNVERIFIED_JWT=0
BACKTEST_SAAS_DB_PATH=data/saas_state.db

# Optional: persist /api/v2/user/settings into Supabase Postgres (recommended for prod)
BACKTEST_SUPABASE_USER_SETTINGS_ENABLED=0
BACKTEST_SUPABASE_URL=https://your-project-ref.supabase.co
BACKTEST_SUPABASE_SERVICE_ROLE_KEY=
BACKTEST_SUPABASE_PUBLISHABLE_KEY=
BACKTEST_SUPABASE_USER_SETTINGS_TABLE=user_settings
BACKTEST_SUPABASE_USER_SETTINGS_TIMEOUT_SEC=8
BACKTEST_SUPABASE_AUTH_VERIFY_TIMEOUT_SEC=4

# Optional: persist finished run reports to Supabase run_summaries
# JSON config defaults can be provided in config/report_storage.json
BACKTEST_REPORT_STORAGE_CONFIG_PATH=
BACKTEST_SUPABASE_RUN_REPORTS_ENABLED=0
BACKTEST_SUPABASE_RUN_REPORTS_TABLE=run_summaries
BACKTEST_SUPABASE_RUN_REPORTS_TIMEOUT_SEC=8
BACKTEST_SUPABASE_RUN_REPORTS_USER_ID=backtest-runner
BACKTEST_SUPABASE_RUN_REPORTS_TENANT_ID=
# Local fallback when Supabase run reports are disabled/unavailable.
# 1 = store into local SQLite run_summaries (default), 0 = filesystem-only fallback.
BACKTEST_LOCAL_RUN_REPORTS_ENABLED=1

# v2 runtime limits
BACKTEST_V2_WORKER_CONCURRENCY=2
BACKTEST_V2_MAX_QUEUE_BACKLOG=100
BACKTEST_V2_JOB_MAX_ATTEMPTS=2
BACKTEST_V2_HEAVY_OPS_ENABLED=1
BACKTEST_MAX_WS_CLIENTS=150

# Billing (optional until Stripe goes live)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

# Market data key
DATABENTO_API_KEY=

# Optional remote market-data manifest (e.g. Cloudflare R2 public JSON)
BACKTEST_REMOTE_MANIFEST_URL=
BACKTEST_DATA_CATALOG_PATH=data/data_catalog.json
BACKTEST_REMOTE_CACHE_DIR=data/remote_cache
BACKTEST_REMOTE_TIMEOUT_SEC=30
BACKTEST_AVAILABLE_DATA_REMOTE_ONLY=0
BACKTEST_REMOTE_MANIFEST_REQUIRED=0
BACKTEST_REMOTE_SYNC_MIN_INTERVAL_SEC=30
BACKTEST_L2_INCLUDE_ICEBERGS_IN_FEATURE_MAP=1
BACKTEST_L2_PRECOMPUTED_FEATURES_ENABLED=1
BACKTEST_L2_PRECOMPUTED_DIR=data/l2_precomputed
BACKTEST_L2_PRECOMPUTED_REQUIRE_FULL_COVERAGE=1
BACKTEST_L2_AUTO_PRECOMPUTE_ON_DOWNLOAD=1
BACKTEST_L2_AUTO_PRECOMPUTE_INCLUDE_ICEBERGS=0
BACKTEST_RUNTIME_CONFIG_DIR=
BACKTEST_AOS_CONFIG_PATH=
BACKTEST_POSITIONING_CONFIG_PATH=

# Fly persistent volume defaults (optional, set in Fly config by default)
# BACKTEST_SAAS_DB_PATH=/data/saas_state.db
# BACKTEST_RUNTIME_CONFIG_DIR=/data/config
# BACKTEST_AOS_CONFIG_PATH=/data/config/aos_config.json
# BACKTEST_POSITIONING_CONFIG_PATH=/data/config/positioning_config.json
# BACKTEST_REMOTE_CACHE_DIR=/data/remote_cache

# Optional private S3/R2 access for remote manifest/data (supports s3:// locations)
# Example:
# BACKTEST_REMOTE_MANIFEST_URL=s3://market-data/mu/manifests/mu_janfeb_manifest.json
# BACKTEST_REMOTE_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
BACKTEST_REMOTE_S3_ENDPOINT=
BACKTEST_REMOTE_S3_ACCOUNT_ID=
BACKTEST_REMOTE_S3_ACCESS_KEY_ID=
BACKTEST_REMOTE_S3_SECRET_ACCESS_KEY=
BACKTEST_REMOTE_S3_REGION=auto
