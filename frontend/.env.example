# Frontend deployment env (Cloudflare Pages / static hosting)
# Backend API base URL (persistent service, without trailing slash).
# Example Fly URL: https://your-backtest-runner-api.fly.dev
VITE_API_BASE_URL=https://your-backtest-runner-api.fly.dev

# Optional dedicated base URL for stateful playback routes (`/api/run*`).
# Use this when general API (`VITE_API_BASE_URL`) points to serverless (e.g. Vercel)
# but playback must target a persistent backend (Render/Railway/Fly).
# If omitted, frontend falls back to VITE_API_BASE_URL for playback.
VITE_PLAYBACK_API_BASE_URL=https://your-backtest-runner-api.fly.dev

# Optional explicit WebSocket base URL.
# If omitted, frontend derives ws:// or wss:// from VITE_API_BASE_URL.
# VITE_WS_BASE_URL=wss://your-backtest-runner-api.fly.dev

# Strategy API URL (second persistent service for market_regime_detection).
VITE_STRATEGY_API_URL=https://your-strategy-api.fly.dev

# Supabase Auth (Google OAuth2 via Supabase)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
# Legacy fallback (older projects): VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Frontend callback path used in signInWithOAuth redirectTo
# Keep this aligned with Supabase "Additional Redirect URLs".
VITE_SUPABASE_OAUTH_CALLBACK_PATH=/auth/callback

# Optional explicit redirect URL for OAuth callback.
# Use when runtime origin differs from public site origin (for example proxy/CDN setups).
# Example: https://your-frontend-domain.com/auth/callback
# VITE_SUPABASE_OAUTH_REDIRECT_URL=
