{
  "name": "backtest-runner-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:rsbuild": "rsbuild dev",
    "build": "vite build",
    "build:rsbuild": "rsbuild build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "preview:rsbuild": "rsbuild preview",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name \"$CLOUDFLARE_PAGES_PROJECT\" --branch \"${CLOUDFLARE_PAGES_BRANCH:-main}\" --commit-dirty=true",
    "deploy:app": "npm run build && npx netlify deploy --prod --dir=dist",
    "deploy:app:ci": "npm run build && npx netlify deploy --prod --dir=dist --site \"$NETLIFY_SITE_ID\" --auth \"$NETLIFY_AUTH_TOKEN\""
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-virtual": "^3.13.19",
    "lightweight-charts": "^4.2.0",
    "lucide-react": "^0.575.0",
    "nuqs": "^2.8.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.7.3",
    "@rsbuild/plugin-react": "^1.4.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^28.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^5.0.0",
    "vitest": "^4.0.18"
  }
}
